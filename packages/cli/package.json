{
  "name": "create-tui",
  "version": "0.0.11",
  "description": "CLI tool for creating OpenTUI projects from templates",
  "keywords": [
    "cli",
    "create-app",
    "generator",
    "opentui",
    "scaffold",
    "template"
  ],
  "homepage": "https://github.com/msmps/create-tui#readme",
  "bugs": {
    "url": "https://github.com/msmps/create-tui/issues"
  },
  "license": "MIT",
  "author": "Matt Simpson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msmps/create-tui.git",
    "directory": "packages/cli"
  },
  "bin": {
    "create-tui": "dist/bin.js"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "vp pack",
    "postbuild": "vpx scripts/post-build.ts",
    "dev": "vpx src/bin/create-tui.ts",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@effect/platform-node": "^4.1.0",
    "effect": "^4.1.0",
    "semver": "^7.8.5",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@types/semver": "^7.8.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
