{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  // Type-checks the CLI package (source, tests, scripts) and Vite+ configs.
  // Templates are Bun projects with their own tsconfig; see check:templates.
  "compilerOptions": {
    // Environment: the CLI runs on Node.js (see engines in packages/cli).
    "lib": ["ESNext"],
    "types": ["node"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",

    // Bundler mode: vp pack bundles the CLI; tsc only type-checks.
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,

    // Strictness
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,

    // Language service
    // Effect diagnostics, run by `effect-tsgo tsc` in the typecheck script.
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          // The CLI relies on effect/cli, effect/http and effect/process by
          // design; their versions are pinned exactly in packages/cli instead.
          "unstableApiUsage": "off"
        }
      }
    ]
  },
  "include": [
    "packages/cli/src/**/*",
    "packages/cli/scripts/**/*",
    "packages/cli/vite.config.ts",
    "vite.config.ts"
  ],
  "exclude": [".repos", "node_modules", "**/dist", "packages/templates"]
}
